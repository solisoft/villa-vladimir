<%# Hero: the pool through a porthole, its horizon drawn across the page %>
<section class="relative overflow-hidden">
    <div class="page relative grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:py-20">
        <div>
            <p class="text-muted"><%= words["hero"]["place"] %></p>
            <h1 class="mt-3 text-[2.6rem] leading-[1.05] sm:text-6xl lg:text-[4.1rem]"><%= words["hero"]["title"] %></h1>
            <p class="measure mt-6 text-lg text-muted"><%= words["hero"]["intro"] %></p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
                <a href="#chambres" class="btn-villa"><%= words["hero"]["cta"] %></a>
            </div>
            <ul class="mt-10 grid gap-2 text-[0.95rem] sm:grid-cols-3 sm:gap-6">
<% for fact in words["hero"]["facts"] %>
                <li class="border-t border-sea/20 pt-3"><%= fact %></li>
<% end %>
            </ul>
        </div>
        <div class="relative mx-auto w-full max-w-[34rem]">
            <div class="horizon -right-[50vw] left-[-4rem] top-[45%] hidden lg:block" aria-hidden="true"></div>
            <div class="porthole relative">
                <img src="<%= hero_photo["src"] %>" alt="<%= hero_photo["alt"] %>" width="1024" height="662" fetchpriority="high">
            </div>
        </div>
    </div>
</section>

<%# The villa and its outdoor spaces, morning to evening %>
<section id="villa" class="border-t border-line bg-white py-20 sm:py-24">
    <div class="page">
        <div class="grid gap-6 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
            <h2 class="section-title"><%= words["villa"]["title"] %></h2>
            <p class="measure text-lg text-muted lg:pt-3"><%= words["villa"]["intro"] %></p>
        </div>

        <ol class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-6">
<% for space, index in spaces %>
            <li class="<%= index < 2 ? "lg:col-span-3" : "lg:col-span-2" %>">
                <img src="<%= space["src"] %>" alt="<%= space["alt"] %>" loading="lazy" class="aspect-[4/3] w-full rounded-2xl object-cover">
                <h3 class="mt-5 text-2xl"><%= space["name"] %></h3>
                <p class="mt-2 text-muted"><%= space["text"] %></p>
            </li>
<% end %>
        </ol>

        <h3 class="mt-20 text-2xl"><%= words["villa"]["gallery_title"] %></h3>
        <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
<% for photo in gallery %>
            <img src="<%= photo["src"] %>" alt="<%= photo["alt"] %>" loading="lazy" class="aspect-[4/3] w-full rounded-xl object-cover">
<% end %>
        </div>
    </div>
</section>

<%# Rooms, with the lowest price of their calendar %>
<section id="chambres" class="py-20 sm:py-24">
    <div class="page">
        <div class="grid gap-6 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
            <h2 class="section-title"><%= words["rooms"]["title"] %></h2>
            <div class="lg:pt-3">
                <p class="measure text-lg text-muted"><%= words["rooms"]["intro"] %></p>
                <p class="measure mt-3 text-muted"><%= words["rooms"]["price_includes"] %></p>
            </div>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2">
<% for room in rooms %>
            <article class="group flex flex-col overflow-hidden rounded-3xl border border-line bg-white">
                <a href="<%= room["path"] %>" class="block overflow-hidden" tabindex="-1" aria-hidden="true">
                    <img src="<%= room["photo"]["src"] %>" alt="" loading="lazy" class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]">
                </a>
                <div class="flex flex-1 flex-col p-6 sm:p-8">
                    <p class="text-sm text-muted"><%= room["kind_label"] %></p>
                    <h3 class="text-3xl"><a href="<%= room["path"] %>" class="hover:text-villa"><%= room["name"] %></a></h3>
                    <p class="mt-3 text-muted"><%= room["tagline"] %></p>
                    <ul class="mt-4 space-y-1 text-[0.95rem]">
<% for feature in room["features"].take(2) %>
                        <li><%= feature %></li>
<% end %>
                    </ul>
                    <div class="mt-auto flex flex-wrap items-end justify-between gap-4 pt-6">
<% if room["from_price"] %>
                        <p class="font-semibold"><%= room["from_price"] %></p>
<% end %>
                        <a href="<%= room["path"] %>" class="text-link"><%= words["rooms"]["see_room"] %></a>
                    </div>
                </div>
            </article>
<% end %>
        </div>
    </div>
</section>

<%# Dining %>
<section id="table" class="bg-sea text-white">
    <div class="page grid gap-12 py-20 sm:py-24 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
        <div>
            <h2 class="text-4xl text-white sm:text-5xl"><%= words["table"]["title"] %></h2>
            <p class="measure mt-6 text-xl text-white/90"><%= words["table"]["lead"] %></p>
<% for paragraph in words["table"]["paragraphs"] %>
            <p class="measure mt-4 text-white/75"><%= paragraph %></p>
<% end %>
            <p class="mt-8 text-white/90"><%= words["table"]["dishes_intro"] %></p>
            <dl class="mt-4 divide-y divide-white/15 border-y border-white/15">
<% for dish in words["table"]["dishes"] %>
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
                    <dt class="font-display text-xl" lang="es"><%= dish["name"] %></dt>
                    <dd class="text-white/70"><%= dish["note"] %></dd>
                </div>
<% end %>
            </dl>
            <p class="mt-4 text-white/75"><%= words["table"]["more"] %></p>
            <p class="measure mt-4 text-white/75"><%= words["table"]["wine"] %></p>
        </div>
        <div class="grid content-start gap-4">
<% for photo in table_photos %>
            <img src="<%= photo["src"] %>" alt="<%= photo["alt"] %>" loading="lazy" class="w-full rounded-2xl">
<% end %>
        </div>
    </div>
</section>

<%# Surroundings, by time from the villa %>
<section id="environs" class="py-20 sm:py-24">
    <div class="page">
        <div class="grid gap-6 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
            <h2 class="section-title"><%= words["surroundings"]["title"] %></h2>
            <p class="measure text-lg text-muted lg:pt-3"><%= words["surroundings"]["intro"] %></p>
        </div>

        <div class="mt-14 grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
            <ol class="space-y-10">
<% for band in words["surroundings"]["bands"] %>
                <li class="band">
                    <h3 class="text-2xl"><%= band["label"] %> <span class="font-sans text-base text-muted"><%= band["detail"] %></span></h3>
                    <ul class="mt-3 grid gap-x-8 gap-y-1.5 text-[0.95rem] sm:grid-cols-2">
<% for place in band["places"] %>
                        <li><%= place %></li>
<% end %>
                    </ul>
                </li>
<% end %>
            </ol>
            <div class="grid grid-cols-2 content-start gap-3">
<% for photo in surroundings_photos %>
                <img src="<%= photo["src"] %>" alt="<%= photo["alt"] %>" loading="lazy" class="aspect-square w-full rounded-xl object-cover">
<% end %>
            </div>
        </div>
    </div>
</section>

<%# Getting here and booking %>
<section id="acces" class="border-t border-line bg-white py-20 sm:py-24">
    <div class="page">
        <h2 class="section-title"><%= words["access"]["title"] %></h2>

        <div class="mt-12 grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
            <div class="rounded-3xl bg-foam p-6 sm:p-10">
                <h3 class="text-3xl"><%= words["access"]["contact_title"] %></h3>
                <p class="mt-3 text-muted"><%= words["access"]["contact_text"] %></p>
                <ul class="mt-6 space-y-3">
<% for phone in site["phones"] %>
                    <li class="flex flex-wrap items-baseline gap-x-3">
                        <span class="w-20 text-muted"><%= words["access"]["phones"][phone["key"]] %></span>
                        <a href="<%= phone["href"] %>" class="font-display text-2xl whitespace-nowrap hover:text-villa sm:text-3xl"><%= phone["number"] %></a>
                    </li>
<% end %>
                    <li class="flex flex-wrap items-baseline gap-x-3">
                        <span class="w-20 text-muted"><%= words["access"]["email_label"] %></span>
                        <a href="mailto:<%= site["email"] %>" class="text-link break-all"><%= site["email"] %></a>
                    </li>
                </ul>
                <p class="mt-8"><a href="<%= terms_href %>" class="text-link"><%= words["access"]["terms"] %></a></p>

                <h3 class="mt-10 text-2xl"><%= words["access"]["address_title"] %></h3>
                <address class="mt-2 not-italic">
                    Vladimir Dream House<br>
                    <%= site["street"] %><br>
                    <%= site["city"] %><br>
                    <span class="text-muted"><%= site["coordinates"] %></span>
                </address>
                <p class="mt-3"><a href="<%= site["map_url"] %>" class="text-link"><%= words["access"]["map_link"] %></a></p>
            </div>

            <div>
                <img src="<%= access_photo["src"] %>" alt="<%= access_photo["alt"] %>" loading="lazy" class="aspect-[16/10] w-full rounded-2xl object-cover">

                <h3 class="mt-10 text-2xl"><%= words["access"]["by_car_title"] %></h3>
                <p class="mt-2 text-muted"><%= words["access"]["by_car_text"] %></p>
                <ul class="mt-4 space-y-2">
<% for itinerary in itineraries %>
                    <li><a href="<%= itinerary["href"] %>" class="text-link"><%= itinerary["label"] %></a> <span class="text-sm text-muted">PDF</span></li>
<% end %>
                </ul>

                <h3 class="mt-10 text-2xl"><%= words["access"]["by_transit_title"] %></h3>
                <dl class="mt-4 divide-y divide-line border-y border-line">
<% for stop in words["access"]["transit"] %>
                    <div class="flex items-baseline justify-between gap-6 py-2.5">
                        <dt><%= stop["place"] %></dt>
                        <dd class="whitespace-nowrap font-semibold"><%= stop["time"] %></dd>
                    </div>
<% end %>
                </dl>
                <p class="mt-4 text-sm text-muted"><%= words["access"]["transit_note"] %></p>
            </div>
        </div>
    </div>
</section>
